{
  "name": "dsh-sidebar-plus",
  "version": "0.4.3",
  "description": "Sidebar file-view enhancement for DSH (zero official-file changes, hot-pluggable): a Source view for .md/.markdown — line numbers, in-file search, direct edit & save (auto backup + overwrite protection), adjustable font size; find/zoom/in-place editing on the official previews; and a toolbar on the official side-by-side comparison view (one-side or both-side search, font size for both sides at once, right-side-only editing). 中文 README 见 README.md / English: README.en.md",
  "author": "sailoumili",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "harness",
    "cordis",
    "plugin",
    "client-plugin",
    "ui",
    "sidebar",
    "preview",
    "file-view",
    "file-preview",
    "viewer",
    "markdown",
    "editor",
    "line-numbers",
    "search",
    "zoom"
  ],
  "homepage": "https://github.com/sailoumili/dsh-sidebar-plus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sailoumili/dsh-sidebar-plus.git"
  },
  "bugs": {
    "url": "https://github.com/sailoumili/dsh-sidebar-plus/issues"
  },
  "type": "module",
  "scripts": {
    "test": "node scripts/test.mjs"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "hot-host.cjs",
    "hot-client.cjs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-files"
      ],
      "platform": "web"
    }
  }
}
